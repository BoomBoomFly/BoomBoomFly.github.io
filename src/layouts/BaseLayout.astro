---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  contentType?: string;
  socialType?: 'website' | 'article';
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  contentType = '页面',
  socialType = 'website',
  image,
  jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const pageTitle = title === site.name ? title : `${title} · ${site.name}`;
const socialImage = image ? new URL(image, Astro.site ?? site.url) : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta data-pagefind-meta="type" content={contentType} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={site.logo} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={socialType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('starlight-theme') ?? localStorage.getItem('boomboomfly-theme');
        } catch {}
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <SiteHeader />
    <main id="main-content" class="page-shell page-main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
