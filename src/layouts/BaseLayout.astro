---
import { Icon } from '@astrojs/starlight/components';
import { navigation, site } from '../config/site';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const pageTitle = title === site.name ? title : `${title} · ${site.name}`;
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta data-pagefind-meta="type" content="页面" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={site.logo} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('starlight-theme') ?? localStorage.getItem('boomboomfly-theme');
        } catch {}
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark'
          ? saved
          : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header" data-site-header>
      <div class="page-shell site-header__inner">
        <a class="brand" href="/" aria-label={`${site.name} 首页`}>
          <span class="brand__mark">
            <img src={site.logo} width="200" height="200" alt="" />
          </span>
          <span class="brand__copy">
            <strong>{site.name}</strong>
            <small>{site.chineseName}</small>
          </span>
        </a>

        <div class="site-header__actions">
          <nav id="site-navigation" aria-label="主导航">
            <ul>
              {navigation.map((item) => {
                const isJoin = item.href === '/about/#join';
                const isCurrent = !item.href.includes('#') && Astro.url.pathname.startsWith(item.href);
                return (
                  <li>
                    <a
                      href={item.href}
                      class={isJoin ? 'nav-pill' : undefined}
                      aria-current={isCurrent ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>

          <button class="theme-toggle" type="button" aria-label="切换到深色主题" title="切换到深色主题" data-theme-toggle>
            <span class="theme-toggle__icon theme-toggle__icon--moon"><Icon name="moon" size="1.1rem" /></span>
            <span class="theme-toggle__icon theme-toggle__icon--sun"><Icon name="sun" size="1.1rem" /></span>
          </button>

          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="打开导航菜单">
            菜单
          </button>
        </div>
      </div>
    </header>
    <main id="main-content" class="page-shell page-main">
      {!isHome && (
        <header class="page-intro">
          <h1>{title}</h1>
        </header>
      )}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="page-shell site-footer__inner">
        <div class="site-footer__brand">
          <p class="site-footer__name">{site.name} · {site.chineseName}</p>
          <p class="site-footer__meta">{site.location}</p>
        </div>
        <nav aria-label="页脚导航">
          {navigation.map(({ href, label }) => <a href={href}>{label}</a>)}
          <a href={site.github} rel="noopener noreferrer">GitHub ↗</a>
        </nav>
      </div>
      <div class="page-shell site-footer__bottom">
        <p>© {new Date().getFullYear()} {site.name}</p>
      </div>
    </footer>
  </body>
</html>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menu = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = header?.querySelector<HTMLElement>('#site-navigation');
  const mobileQuery = window.matchMedia('(max-width: 56rem)');

  const closeMenu = (restoreFocus = false) => {
    if (menu?.getAttribute('aria-expanded') !== 'true') return;
    menu.setAttribute('aria-expanded', 'false');
    if (restoreFocus) menu.focus();
  };

  const openMenu = () => {
    menu?.setAttribute('aria-expanded', 'true');
    nav?.querySelector<HTMLElement>('a')?.focus();
  };

  menu?.addEventListener('click', () => {
    menu.getAttribute('aria-expanded') === 'true' ? closeMenu(true) : openMenu();
  });
  nav?.querySelectorAll('a').forEach((item) => item.addEventListener('click', () => closeMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') {
      event.preventDefault();
      closeMenu(true);
    }
  });
  document.addEventListener('pointerdown', (event) => {
    if (menu?.getAttribute('aria-expanded') !== 'true') return;
    if (event.target instanceof Node && !nav?.contains(event.target) && !menu.contains(event.target)) closeMenu(false);
  });
  mobileQuery.addEventListener('change', () => closeMenu(false));

  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const syncTheme = (theme: string) => {
    const dark = theme === 'dark';
    toggle?.setAttribute('aria-pressed', String(dark));
    const action = dark ? '切换到浅色主题' : '切换到深色主题';
    toggle?.setAttribute('aria-label', action);
    toggle?.setAttribute('title', action);
  };

  syncTheme(document.documentElement.dataset.theme ?? 'light');
  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('starlight-theme', next);
    } catch {}
    syncTheme(next);
  });
</script>

<noscript>
  <style is:global>
    @media (max-width: 56rem) {
      .menu-toggle { display: none !important; }
      #site-navigation { position: static !important; display: block !important; border: 0 !important; padding: 0 !important; background: transparent !important; box-shadow: none !important; }
      #site-navigation ul { display: flex !important; max-width: calc(100vw - (2 * var(--space-page))); overflow-x: auto; }
      #site-navigation a { white-space: nowrap; }
    }
  </style>
</noscript>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 35;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 84%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  .site-header__inner {
    display: flex;
    min-height: var(--header-height);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }
  .brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.78rem;
    color: var(--color-text);
    text-decoration: none;
  }
  .brand__mark {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-xs);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }
  .brand:hover .brand__mark {
    transform: rotate(-4deg) scale(1.03);
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
  }
  .brand img {
    width: 2.15rem;
    height: 2.15rem;
    object-fit: contain;
    filter: var(--logo-filter);
  }
  .brand__copy {
    display: grid;
    gap: 0.22rem;
    line-height: 1;
  }
  .brand strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 820;
    letter-spacing: -0.02em;
  }
  .brand small {
    color: var(--color-text-muted);
    font-size: 0.72rem;
    font-weight: 560;
    letter-spacing: 0.02em;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .site-header nav ul {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-header nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-size: 0.92rem;
    font-weight: 640;
    text-decoration: none;
    transition: color var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast);
  }
  .site-header nav a:hover {
    background: var(--color-surface-strong);
    color: var(--color-text);
  }
  .site-header nav a[aria-current='page'] {
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }
  .site-header nav a.nav-pill {
    margin-left: 0.25rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 28%, var(--color-border));
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }
  .site-header nav a.nav-pill:hover,
  .site-header nav a.nav-pill[aria-current='page'] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .theme-toggle {
    display: grid;
    width: 2.45rem;
    height: 2.45rem;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 0;
    background: var(--color-surface);
    color: var(--color-text-muted);
    box-shadow: var(--shadow-xs);
    cursor: pointer;
    transition: transform var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }
  .theme-toggle:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }
  .theme-toggle__icon {
    display: grid;
    grid-area: 1 / 1;
    place-items: center;
    line-height: 0;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }
  .theme-toggle__icon--sun,
  .theme-toggle[aria-pressed='true'] .theme-toggle__icon--moon {
    opacity: 0;
    transform: scale(0.75) rotate(-18deg);
  }
  .theme-toggle__icon--moon,
  .theme-toggle[aria-pressed='true'] .theme-toggle__icon--sun {
    opacity: 1;
    transform: scale(1) rotate(0);
  }
  .menu-toggle {
    display: none;
    min-width: 3.3rem;
    min-height: 2.45rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding-inline: 0.9rem;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 680;
    box-shadow: var(--shadow-xs);
    cursor: pointer;
  }

  .page-intro {
    display: grid;
    gap: var(--space-3);
    padding-block: clamp(2.5rem, 5.5vw, 4.25rem) var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .site-footer {
    margin-top: var(--space-7);
    border-top: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface-strong) 72%, var(--color-bg));
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-6) var(--space-5);
  }
  .site-footer__brand {
    display: grid;
    gap: 0.3rem;
  }
  .site-footer__name {
    font-family: var(--font-display);
    font-weight: 760;
    font-size: 0.98rem;
    color: var(--color-text);
  }
  .site-footer__meta {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.25rem;
  }
  .site-footer nav a {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .site-footer nav a:hover {
    color: var(--color-accent);
  }
  .site-footer__bottom {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-4);
  }
  .site-footer__bottom p {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  @media (max-width: 56rem) {
    .menu-toggle { display: inline-flex; align-items: center; justify-content: center; }
    .site-header nav {
      position: absolute;
      top: calc(100% + 0.55rem);
      right: var(--space-page);
      left: var(--space-page);
      display: none;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: var(--space-3);
      background: var(--color-surface);
      box-shadow: var(--shadow-float);
    }
    .site-header__actions:has(.menu-toggle[aria-expanded='true']) nav { display: block; }
    .site-header nav ul {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-2);
    }
    .site-header nav a {
      justify-content: center;
      min-height: 2.75rem;
    }
    .site-header nav a.nav-pill { margin-left: 0; }
  }

  @media (max-width: 34rem) {
    .brand__mark { width: 2.35rem; height: 2.35rem; }
    .brand img { width: 1.85rem; height: 1.85rem; }
    .brand small { display: none; }
  }
</style>

<style is:global>
*, *::before, *::after { box-sizing: border-box; }

html {
  min-width: 20rem;
  background: var(--color-bg);
  scroll-behavior: smooth;
}
img { display: block; max-width: 100%; }
button, input, select, textarea { font: inherit; }
button { color: inherit; }
[hidden] { display: none !important; }

:focus-visible { outline: 2.5px solid var(--color-focus); outline-offset: 3px; border-radius: 4px; }
::selection { background: var(--color-accent-soft); color: var(--color-text); }

body {
  margin: 0;
  overflow-x: hidden;
  background:
    radial-gradient(ellipse 68% 36% at 82% -4%, var(--glow-primary), transparent 65%),
    radial-gradient(ellipse 52% 30% at 10% 18%, var(--glow-secondary), transparent 62%),
    var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-sans);
  font-size: 1rem;
  line-height: 1.75;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}

h1,
h2,
h3,
h4 {
  margin: 0;
  color: var(--color-text);
  font-family: var(--font-display);
  font-weight: 760;
  line-height: 1.2;
  letter-spacing: -0.025em;
}

h1 { font-size: clamp(2.15rem, 4.4vw, 3.35rem); line-height: 1.15; }
h2 { font-size: clamp(1.55rem, 2.7vw, 2.15rem); }
h3 { font-size: clamp(1.15rem, 1.6vw, 1.35rem); }
h4 { font-size: 1.02rem; letter-spacing: -0.01em; }

p { margin: 0; }
a {
  color: inherit;
  text-decoration-thickness: 0.08em;
  text-underline-offset: 0.22em;
  transition: color var(--transition-fast);
}
code, pre { font-family: var(--font-mono); }

.page-shell {
  width: min(calc(100% - (2 * var(--space-page))), var(--page-width));
  margin-inline: auto;
}

.page-main {
  min-height: calc(100vh - var(--header-height) - 11rem);
  padding-bottom: var(--space-8);
}

.stack-lg { display: grid; gap: var(--space-6); }

.pill-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  width: fit-content;
  padding: 0.38rem 0.85rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  color: var(--color-text-muted);
  font-size: 0.82rem;
  font-weight: 600;
  box-shadow: var(--shadow-xs);
}

.surface-card {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
  transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
}

.surface-card--interactive:hover {
  transform: translateY(-4px);
  border-color: color-mix(in srgb, var(--color-accent) 42%, var(--color-border));
  box-shadow: var(--shadow-float);
}

.button-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.85rem; }

.button {
  display: inline-flex;
  min-height: 2.9rem;
  align-items: center;
  justify-content: center;
  gap: 0.45rem;
  border: 1px solid var(--color-accent);
  border-radius: var(--radius-pill);
  padding: 0.65rem 1.35rem;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 0.94rem;
  font-weight: 680;
  text-decoration: none;
  box-shadow: 0 6px 18px -6px color-mix(in srgb, var(--color-accent) 45%, transparent);
  transition: transform var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast);
}

.button:hover {
  transform: translateY(-2px);
  background: var(--color-accent-strong);
  border-color: var(--color-accent-strong);
  box-shadow: 0 10px 24px -6px color-mix(in srgb, var(--color-accent) 52%, transparent);
}
.button:active { transform: translateY(0) scale(0.985); }

.button.secondary {
  border-color: var(--color-border-strong);
  background: var(--color-surface);
  color: var(--color-text);
  box-shadow: var(--shadow-xs);
}
.button.secondary:hover {
  border-color: var(--color-accent);
  background: var(--color-accent-soft);
  color: var(--color-accent-strong);
  box-shadow: var(--shadow-soft);
}

.text-link {
  display: inline-flex;
  min-height: 2.6rem;
  align-items: center;
  gap: 0.35rem;
  color: var(--color-accent);
  font-size: 0.94rem;
  font-weight: 680;
  text-decoration: none;
  transition: color var(--transition-fast), gap var(--transition-fast);
}
.text-link:hover {
  color: var(--color-accent-strong);
  text-decoration: underline;
  text-underline-offset: 0.25em;
}

.subpage-section {
  padding-block: var(--space-section);
}
.subpage-section + .subpage-section {
  border-top: 1px solid var(--color-border);
}

.section-header {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-4);
}

.prose { max-width: 72ch; color: var(--color-text); }
.prose h3 { margin-block: var(--space-6) var(--space-3); font-size: 1.2rem; }
.prose h3:first-child { margin-top: 0; }
.prose p { margin-block: var(--space-4); color: var(--color-text); }
.prose p:first-child { margin-top: 0; }
.prose ul { display: grid; gap: 0.65rem; margin-block: var(--space-4); padding-left: 1.35rem; }
.prose li { color: var(--color-text-muted); }
.prose li strong, .prose li a { color: var(--color-text); }
.prose img {
  margin-block: var(--space-5);
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-soft);
}
.prose a {
  color: var(--color-accent);
  font-weight: 600;
  text-decoration-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
}
.prose a:hover { color: var(--color-accent-strong); }
.prose .sl-anchor-link { display: none; }

.skip-link {
  position: fixed;
  z-index: 100;
  top: var(--space-3);
  left: var(--space-3);
  transform: translateY(-200%);
  border-radius: var(--radius-sm);
  padding: 0.65rem 1rem;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-weight: 700;
  text-decoration: none;
}
.skip-link:focus { transform: translateY(0); }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.page-main > * {
  animation: fadeUp 480ms var(--ease-out) both;
}
.page-main > *:nth-child(2) { animation-delay: 60ms; }
.page-main > *:nth-child(3) { animation-delay: 120ms; }
.page-main > *:nth-child(4) { animation-delay: 180ms; }

@media (max-width: 64rem) {
  .page-main { padding-bottom: var(--space-7); }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}
</style>
