---
const topics = [
  { id: 'sensors', title: '传感器', description: 'IMU、相机和定位设备采集机体运动与周围环境的数据。', href: '/knowledge/research/perception-localization/', link: '感知与定位资料' },
  { id: 'flight-control', title: '飞控 / PX4', description: '飞控根据传感器数据估计姿态和位置，实时调整飞行状态。', href: '/knowledge/research/flight-control/', link: '飞行控制与 ROS' },
  { id: 'ros2', title: 'ROS 2', description: 'ROS 2 的节点和话题连接感知、规划与控制模块。', href: '/knowledge/tools/learning-paths/ros2/', link: 'ROS 2 学习路线' },
  { id: 'perception', title: '智能感知', description: '感知算法从图像和定位数据中估计位姿，识别障碍物。', href: '/knowledge/research/perception-localization/', link: '感知算法与设备' },
  { id: 'actuators', title: '执行机构', description: '电机、舵机和移动底盘把控制指令转化为运动。', href: '/knowledge/#robotics', link: '机器人与智能系统' },
];
---

<section class="system-map" aria-labelledby="knowledge-system-map-title">
  <div class="system-map__header">
    <h2 id="knowledge-system-map-title">从输入到动作</h2>
    <output class="system-map__progress" hidden aria-live="polite"></output>
  </div>

  <div class="system-map__list" id="knowledge-system-detail">
    {topics.map(({ id, title, description, href, link }, index) => (
      <details name="system-topic" data-topic={id} open={id === 'flight-control'}>
        <summary>
          <span class="system-map__step">{String(index + 1).padStart(2, '0')}</span>
          <span class="system-map__title">{title}</span>
          <small class="system-map__done" hidden>已读</small>
        </summary>
        <p>{description} <a href={href}>{link} →</a></p>
      </details>
    ))}
  </div>
</section>

<script>
  const topics = Array.from(document.querySelectorAll<HTMLDetailsElement>('#knowledge-system-detail details'));
  const progress = document.querySelector<HTMLOutputElement>('.system-map__progress');
  if (progress) {
    const key = 'boomboomfly-knowledge-system-map';
    let saved: unknown = [];
    try { saved = JSON.parse(localStorage.getItem(key) ?? '[]'); } catch {}
    const visited = new Set(topics.map((topic) => topic.dataset.topic!).filter((id) => Array.isArray(saved) && saved.includes(id)));
    const update = () => {
      for (const topic of topics) {
        const id = topic.dataset.topic!;
        if (topic.open) visited.add(id);
        topic.querySelector('small')!.hidden = !visited.has(id);
      }
      progress.value = `本机已读 ${visited.size} / ${topics.length}`;
      try { localStorage.setItem(key, JSON.stringify([...visited])); } catch {}
    };
    topics.forEach((topic) => topic.addEventListener('toggle', update));
    update();
    progress.hidden = false;
  }
</script>

<style>
  .system-map {
    display: grid;
    gap: 1rem;
    margin-block: 1rem 2rem;
    padding: clamp(1.15rem, 2.5vw, 1.6rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }
  .system-map__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .system-map__header h2 {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: 1.28rem;
  }
  .system-map__lead {
    margin: 0.3rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .system-map__progress {
    padding: 0.28rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    font: 680 0.78rem/1.3 var(--font-mono);
  }
  .system-map__list {
    display: grid;
    gap: 0.55rem;
  }
  details {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    background: color-mix(in srgb, var(--color-surface-strong) 45%, var(--color-surface));
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  details[open] {
    border-color: color-mix(in srgb, var(--color-accent) 42%, var(--color-border));
    background: var(--color-surface);
  }
  summary {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    cursor: pointer;
    font-weight: 700;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .system-map__step {
    display: inline-grid;
    place-items: center;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    font: 700 0.75rem/1 var(--font-mono);
  }
  .system-map__title {
    flex: 1;
  }
  .system-map__done {
    padding: 0.16rem 0.55rem;
    border-radius: var(--radius-pill);
    background: var(--color-tooling-soft);
    color: var(--color-tooling);
    font-size: 0.74rem;
    font-weight: 680;
  }
  details p {
    margin: 0.65rem 0 0.15rem 2.3rem;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }
</style>
