---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import ProjectDirectory, { frontmatter } from '../../content/docs/knowledge/tools/public-projects/index.md';
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <section class="subpage-section stack-lg" aria-labelledby="repos-title">
    <div class="section-header">
      <h2 id="repos-title">GitHub 仓库</h2>
      <nav class="button-row" aria-label="GitHub 导航">
        <a class="button" href={site.github} rel="noopener noreferrer">GitHub 主页 ↗</a>
        <a class="button secondary" href="https://github.com/orgs/BoomBoomFly/repositories" rel="noopener noreferrer">全部仓库</a>
      </nav>
    </div>

    <div class="surface-card projects-card">
      <div class="prose"><ProjectDirectory /></div>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-card {
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }
  .projects-card :global(ul) {
    list-style: none;
    padding-left: 0;
    gap: 0.85rem;
  }
  .projects-card :global(li) {
    padding: 0.95rem 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface-strong) 48%, var(--color-surface));
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }
  .projects-card :global(li:hover) {
    border-color: color-mix(in srgb, var(--color-accent) 42%, var(--color-border));
    transform: translateY(-2px);
  }
</style>
