---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
---

<BaseLayout title="加入我们" description={`了解${site.chineseName}的研究方向、公开项目和联系方式。`}>
  <section class="subpage-section stack-lg" aria-labelledby="contact-title">
    <h2 id="contact-title">联系实验室</h2>
    <p>欢迎来信咨询项目交流或加入实验室的事宜。你可以先浏览<a id="interests-title" href="/#research-heading">研究方向</a>和<a href="/projects/">公开项目</a>。</p>
    <address>
      <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
      <p id="location-title">{site.location}</p>
    </address>
  </section>
</BaseLayout>

<style>
  address { font-style: normal; }
</style>
