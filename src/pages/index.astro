---
import BaseLayout from '../layouts/BaseLayout.astro';
import { researchDirections, site } from '../config/site';

const description = `${site.chineseName}（${site.name}）的研究方向、公开代码仓库与工程知识库。`;
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  alternateName: [site.englishName, site.chineseName, site.shortName],
  url: site.url,
  logo: new URL(site.logo, site.url).toString(),
  foundingDate: site.established,
  address: {
    '@type': 'PostalAddress',
    addressLocality: '厦门',
    addressRegion: '福建',
    addressCountry: 'CN',
  },
  sameAs: [site.github],
};
---

<BaseLayout title={site.name} description={description} jsonLd={organizationJsonLd}>
  <section class="home-hero" aria-labelledby="hero-title">
    <p class="eyebrow">{site.englishName}</p>
    <h1 id="hero-title">我们研究无人机与地面机器人的<strong>感知与协同</strong>。</h1>
    <nav class="button-row" aria-label="了解实验室">
      <a class="button" href="#research-heading">研究方向</a>
      <a class="button secondary" href="/projects/">公开项目</a>
      <a class="text-link" id="team-heading" href="/about/">实验室介绍</a>
      <a class="text-link" href="/join/">加入我们</a>
    </nav>
  </section>

  <section class="subpage-section stack-lg" aria-labelledby="research-heading">
    <h2 id="research-heading">研究方向</h2>
    <ul class="direction-links" id="directions-title">
      {researchDirections.map(({ title, guideTitle, href }) => (
        <li><a href={href}><strong>{title}</strong><span>{guideTitle ?? '方向资料'} →</span></a></li>
      ))}
    </ul>
    <a class="text-link" id="knowledge-heading" href="/knowledge/">浏览完整知识库</a>
  </section>

  <section class="subpage-section stack-lg" aria-labelledby="projects-heading">
    <h2 id="projects-heading">公开项目</h2>
    <p>实验室的 GitHub 组织 BoomBoomFly 收录了室内无人机工作区、移动机器人资料，以及视觉惯性定位和串口通信项目。</p>
    <div class="button-row">
      <a class="button secondary" href="/projects/">按项目查找源码</a>
      <a class="text-link" href={site.github}>访问 GitHub 组织主页</a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { display: grid; align-content: center; gap: var(--space-6); padding-block: var(--space-section); border-bottom: 1px solid var(--color-border-strong); }
  .home-hero h1 { max-width: 18ch; font-size: clamp(2.65rem, 7vw, 6.5rem); font-weight: 560; line-height: 1.08; }
  .home-hero h1 strong { color: var(--color-accent); }
  .direction-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: var(--space-5); margin: 0; padding: 0; list-style: none; }
  .direction-links a { display: grid; gap: var(--space-2); border-top: 1px solid var(--color-border-strong); padding-block: var(--space-5); text-decoration: none; }
  .direction-links strong { font-size: clamp(1.3rem, 2.5vw, 2rem); }
  .direction-links span { color: var(--color-accent-strong); }
  .direction-links a:hover strong { text-decoration: underline; }
</style>
