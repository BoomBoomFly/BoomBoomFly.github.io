---
import DirectionList from '../components/DirectionList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const description = '集美大学无人机科创实验室。';
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  alternateName: [site.shortName, site.chineseName],
  url: site.url,
  logo: new URL(site.logo, site.url).toString(),
  foundingDate: site.established,
  address: {
    '@type': 'PostalAddress',
    addressLocality: '厦门',
    addressRegion: '福建',
    addressCountry: 'CN',
  },
  sameAs: [site.github],
};

const knowledgePaths = [
  { index: '01', title: '飞行控制与 ROS', href: '/knowledge/research/flight-control/' },
  { index: '02', title: '感知、定位与通信', href: '/knowledge/research/perception-localization/' },
  { index: '03', title: '机器人与智能系统', href: '/knowledge/research/robotics-intelligence/' },
  { index: '04', title: '开发环境与工具', href: '/knowledge/tools/' },
];
---

<BaseLayout title={site.name} description={description} jsonLd={organizationJsonLd}>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="home-hero__content">
      <p class="section-marker"><span>01</span> / INTRO</p>
      <h1 id="hero-title">我们构建无人机、机器人与<strong>智能感知系统</strong>。</h1>
      <div class="button-row" aria-label="主要入口">
        <a class="button" href="/projects/">查看项目</a>
        <a class="button secondary" href="/join/">加入我们</a>
      </div>
      <nav class="home-hero__links" aria-label="更多入口">
        <a href="/research/">研究方向</a>
        <a href="/knowledge/">知识库</a>
        <a href="/about/">实验室介绍</a>
      </nav>
    </div>
  </section>

  <section class="home-section stack-lg" aria-labelledby="research-heading">
    <div class="section-heading">
      <div>
        <p class="section-marker"><span>02</span> / RESEARCH</p>
        <h2 id="research-heading">研究方向</h2>
      </div>
    </div>
    <DirectionList headingLevel="h3" />
  </section>

  <section class="home-section stack-lg" aria-labelledby="projects-heading">
    <div class="section-heading">
      <div>
        <p class="section-marker"><span>03</span> / PROJECTS</p>
        <h2 id="projects-heading">项目档案</h2>
      </div>
    </div>
    <div class="empty-state">
      <span class="status-label">整理中</span>
      <div class="button-row">
        <a class="button secondary" href="/projects/">项目档案</a>
        <a class="text-link" href="/research/">研究方向</a>
      </div>
    </div>
  </section>

  <section class="home-section stack-lg" aria-labelledby="knowledge-heading">
    <div class="section-heading">
      <div>
        <p class="section-marker"><span>04</span> / KNOWLEDGE</p>
        <h2 id="knowledge-heading">知识库</h2>
      </div>
    </div>
    <div class="knowledge-grid">
      {knowledgePaths.map((item) => (
        <a class="knowledge-card" href={item.href}>
          <span>{item.index}</span>
          <h3>{item.title}</h3>
          <strong aria-hidden="true">进入文档 →</strong>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section home-section--closing stack-lg" aria-labelledby="team-heading">
    <div class="section-heading">
      <div>
        <p class="section-marker"><span>05</span> / TEAM & JOIN</p>
        <h2 id="team-heading">实验室介绍与加入</h2>
      </div>
    </div>
    <div class="closing-grid">
      <article>
        <p class="eyebrow">TEAM</p>
        <h3>实验室介绍</h3>
        <a class="text-link" href="/about/">查看实验室介绍</a>
      </article>
      <article>
        <p class="eyebrow">JOIN</p>
        <h3>加入实验室</h3>
        <a class="button" href="/join/">加入我们</a>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    display: grid;
    min-height: calc(100vh - var(--header-height));
    align-content: center;
    padding-block: clamp(3.5rem, 9vw, 8rem) clamp(4rem, 10vw, 7rem);
  }
  .home-hero__content { display: grid; max-width: 72rem; gap: clamp(1.15rem, 2.4vw, 1.8rem); }
  .home-hero h1 { max-width: 18ch; font-size: clamp(3rem, 7vw, 6.5rem); font-weight: 560; line-height: 1.08; letter-spacing: -.06em; }
  .home-hero h1 strong { color: var(--color-accent); font-weight: 860; }
  .home-hero__links { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: .35rem; }
  .home-hero__links a { color: var(--color-text-muted); font-size: .85rem; font-weight: 720; text-underline-offset: .3rem; }
  .home-section { border-top: 1px solid var(--color-border-strong); padding-block: var(--space-section); }
  .home-section--closing { padding-bottom: clamp(5rem, 12vw, 10rem); }
  .knowledge-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--color-border-strong); border-left: 1px solid var(--color-border); }
  .knowledge-card { display: grid; min-height: 14rem; align-content: start; gap: var(--space-4); border-right: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: clamp(1.5rem, 4vw, 3rem); color: var(--color-text); text-decoration: none; transition: background var(--transition-fast), transform var(--transition-fast); }
  .knowledge-card:hover { background: var(--color-surface); transform: translateY(-.2rem); }
  .knowledge-card > span { color: var(--color-accent); font: 750 .75rem/1 var(--font-mono); }
  .knowledge-card h3 { max-width: 15ch; font-size: clamp(1.6rem, 3vw, 2.6rem); }
  .knowledge-card strong { margin-top: auto; color: var(--color-accent-strong); font-size: .82rem; }
  .closing-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-block: 1px solid var(--color-border-strong); }
  .closing-grid article { display: grid; min-height: 16rem; align-content: start; gap: var(--space-5); padding: clamp(1.5rem, 5vw, 4rem); }
  .closing-grid article + article { border-left: 1px solid var(--color-border); background: var(--color-surface); }
  .closing-grid h3 { font-size: clamp(2rem, 4vw, 3.7rem); }
  .closing-grid a { margin-top: auto; width: fit-content; }
  @media (max-width: 64rem) { .home-hero { min-height: auto; } .home-hero h1 { max-width: 20ch; } }
  @media (max-width: 44rem) {
    .home-hero { padding-block: 4.5rem 6rem; }
    .home-hero h1 { font-size: clamp(2.65rem, 13vw, 4.2rem); letter-spacing: -.055em; }
    .knowledge-grid, .closing-grid { grid-template-columns: 1fr; }
    .knowledge-card { min-height: 15rem; }
    .closing-grid article + article { border-top: 1px solid var(--color-border); border-left: 0; }
  }
</style>
