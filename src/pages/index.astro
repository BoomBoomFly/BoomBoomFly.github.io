---
import BaseLayout from '../layouts/BaseLayout.astro';
import { researchDirections, site } from '../config/site';
import ProjectDirectory from '../content/docs/knowledge/tools/public-projects/index.md';

const description = `${site.chineseName}（${site.name}）的研究方向、公开代码仓库与工程知识库。`;
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  alternateName: [site.englishName, site.chineseName, site.shortName],
  url: site.url,
  logo: new URL(site.logo, site.url).toString(),
  foundingDate: site.established,
  address: {
    '@type': 'PostalAddress',
    addressLocality: '厦门',
    addressRegion: '福建',
    addressCountry: 'CN',
  },
  sameAs: [site.github],
};

const directionIcons: Record<string, string> = {
  flight: `<path d="M12 3v18M3 12h18M5.5 5.5l13 13M18.5 5.5l-13 13"/><circle cx="12" cy="12" r="3"/>`,
  perception: `<circle cx="12" cy="12" r="3"/><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/>`,
  robotics: `<rect x="4" y="7" width="16" height="10" rx="3"/><path d="M9 7V4M15 7V4M9 17v3M15 17v3"/><circle cx="9.5" cy="12" r="1"/><circle cx="14.5" cy="12" r="1"/>`,
  tools: `<path d="M8 9l-3 3 3 3M16 9l3 3-3 3M13 6l-2 12"/>`,
};
---

<BaseLayout title={site.name} description={description} jsonLd={organizationJsonLd}>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="home-hero__copy">
      <p class="pill-badge">
        <span class="status-dot" aria-hidden="true"></span>
        <span>{site.location}</span>
      </p>
      <h1 id="hero-title">
        我们研究无人机与地面机器人的<strong>感知与协同</strong>
      </h1>
      <p class="home-hero__lead">
        {site.chineseName}（{site.name}）成立于 {site.established} 年，研究 PX4 飞控、视觉定位与移动机器人，代码和文档在 GitHub 公开。
      </p>
      <nav class="button-row" aria-label="了解实验室">
        <a class="button" href="/knowledge/">进入知识库</a>
        <a class="button secondary" href="/about/">关于实验室</a>
      </nav>
    </div>

    <div class="home-hero__visual">
      <article class="surface-card showcase-card">
        <div class="showcase-card__media">
          <img
            src="/images/generated/legacy/gitbook/drone.jpg"
            alt="实验室多旋翼无人机"
            loading="eager"
          />
          <span class="showcase-card__chip">PX4 · ROS 2 · VIO</span>
        </div>
      </article>
    </div>
  </section>

  <section class="subpage-section stack-lg" aria-labelledby="research-heading">
    <div class="section-header">
      <h2 id="research-heading">研究方向</h2>
      <a class="text-link" href="/knowledge/">完整知识库 →</a>
    </div>

    <ul class="direction-grid">
      {researchDirections.map(({ id, title, summary, guideTitle, href }) => (
        <li>
          <a class="surface-card surface-card--interactive direction-card" href={href}>
            <span class="direction-card__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={directionIcons[id]} />
            </span>
            <div class="direction-card__body">
              <h3>{title}</h3>
              <p>{summary}</p>
            </div>
            <span class="direction-card__foot">
              <span>{guideTitle}</span>
              <span class="direction-card__arrow" aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="subpage-section stack-lg" id="projects" aria-labelledby="projects-heading">
    <div class="section-header">
      <h2 id="projects-heading">公开项目</h2>
      <nav class="button-row" aria-label="GitHub 导航">
        <a class="button secondary" href={site.github} rel="noopener noreferrer">GitHub 主页 ↗</a>
        <a class="text-link" href="https://github.com/orgs/BoomBoomFly/repositories" rel="noopener noreferrer">全部仓库 →</a>
      </nav>
    </div>

    <div class="surface-card projects-card">
      <div class="prose"><ProjectDirectory /></div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 4.5vw, 4rem);
    padding-block: clamp(2.75rem, 6vw, 4.75rem) var(--space-section);
  }
  .home-hero__copy {
    display: grid;
    gap: var(--space-5);
  }
  .home-hero h1 {
    font-size: clamp(2.2rem, 4.3vw, 3.45rem);
    font-weight: 780;
    line-height: 1.16;
  }
  .home-hero h1 strong {
    color: var(--color-accent);
    font-weight: 820;
  }
  .home-hero__lead {
    max-width: 50ch;
    color: var(--color-text-muted);
    font-size: clamp(0.98rem, 1.25vw, 1.06rem);
    line-height: 1.8;
  }

  .status-dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-tooling);
  }

  .showcase-card {
    padding: 0.85rem;
  }
  .showcase-card__media {
    position: relative;
    overflow: hidden;
    border-radius: calc(var(--radius-lg) - 0.35rem);
    aspect-ratio: 16 / 11;
    background: var(--color-surface-strong);
  }
  .showcase-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }
  .showcase-card:hover .showcase-card__media img {
    transform: scale(1.03);
  }
  .showcase-card__chip {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    backdrop-filter: blur(10px);
    color: var(--color-text);
    font: 680 0.72rem/1.2 var(--font-mono);
    letter-spacing: 0.04em;
    border: 1px solid var(--color-border);
  }

  .direction-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .direction-grid li {
    display: flex;
  }
  .direction-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    width: 100%;
    padding: var(--space-5);
    text-decoration: none;
  }
  .direction-card__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
  .direction-card__body {
    display: grid;
    gap: 0.45rem;
  }
  .direction-card__body p {
    color: var(--color-text-muted);
    font-size: 0.91rem;
    line-height: 1.65;
  }
  .direction-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-accent);
    font-size: 0.88rem;
    font-weight: 680;
  }
  .direction-card__arrow {
    transition: transform var(--transition-fast);
  }
  .direction-card:hover .direction-card__arrow {
    transform: translateX(4px);
  }

  .projects-card {
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }
  .projects-card :global(.prose) {
    max-width: none;
  }
  .projects-card :global(ul) {
    list-style: none;
    padding-left: 0;
    gap: 0.85rem;
  }
  .projects-card :global(li) {
    padding: 0.95rem 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface-strong) 48%, var(--color-surface));
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }
  .projects-card :global(li:hover) {
    border-color: color-mix(in srgb, var(--color-accent) 42%, var(--color-border));
    transform: translateY(-2px);
  }

  @media (max-width: 58rem) {
    .home-hero {
      grid-template-columns: 1fr;
      padding-top: var(--space-6);
    }
  }
</style>
