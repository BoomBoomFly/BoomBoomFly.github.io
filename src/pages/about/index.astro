---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import LabIntroduction from '../../content/docs/knowledge/history/lab-introduction/index.md';
import TeamRoster from '../../content/docs/knowledge/history/team/index.md';
---

<BaseLayout title="关于实验室" description={`${site.chineseName}（${site.name}）的研究方向、团队名录与联系方式。`}>
  <section class="subpage-section stack-lg" id="lab-introduction" aria-labelledby="lab-introduction-title">
    <h2 id="lab-introduction-title">实验室资料</h2>
    <div class="surface-card about-card">
      <div class="prose"><LabIntroduction /></div>
    </div>
  </section>

  <section class="subpage-section stack-lg" id="team-roster" aria-labelledby="team-roster-title">
    <h2 id="team-roster-title">团队名录</h2>
    <div class="surface-card about-card">
      <div class="prose team-prose">
        <TeamRoster />
      </div>
    </div>
  </section>

  <section class="subpage-section stack-lg" id="join" aria-labelledby="contact-title">
    <h2 id="contact-title">联系与加入</h2>
    <div class="join-grid">
      <article class="surface-card join-card">
        <p class="join-card__desc">
          项目交流或申请加入可以直接发邮件，也可以到克立楼找我们。来信前建议先看一遍<a href="/#research-heading">研究方向</a>和<a href="/#projects">公开项目</a>，附上专业与感兴趣的方向即可。
        </p>
        <div class="button-row">
          <a class="button" href={`mailto:${site.email}`}>发送邮件</a>
          <a class="button secondary" href="/knowledge/tools/learning-paths/">看学习路线</a>
        </div>
      </article>

      <aside class="surface-card contact-card" aria-label="联系方式与地点">
        <address class="contact-list">
          <div class="contact-item">
            <span class="contact-item__label">邮箱</span>
            <a class="contact-item__value" href={`mailto:${site.email}`}>{site.email}</a>
          </div>

          <div class="contact-item">
            <span class="contact-item__label">地点</span>
            <p class="contact-item__value">{site.location}</p>
          </div>

          <div class="contact-item">
            <span class="contact-item__label">GitHub</span>
            <a class="contact-item__value" href={site.github} rel="noopener noreferrer">github.com/BoomBoomFly ↗</a>
          </div>
        </address>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .about-card {
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }
  .team-prose {
    max-width: none;
  }
  .team-prose :global(ul) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    padding-left: 0;
    list-style: none;
  }
  .team-prose :global(li) {
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-surface-strong) 55%, var(--color-surface));
    color: var(--color-text);
    font-size: 0.92rem;
    font-weight: 560;
  }
  .team-prose :global(li a) {
    text-decoration: none;
  }
  .team-prose :global(li a:hover) {
    text-decoration: underline;
  }

  .join-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: var(--space-5);
    align-items: start;
  }
  .join-card,
  .contact-card {
    display: grid;
    gap: var(--space-4);
    padding: clamp(1.5rem, 3.2vw, 2.25rem);
  }
  .contact-card {
    background: linear-gradient(160deg, var(--color-surface), var(--color-accent-soft));
  }
  .join-card__desc {
    color: var(--color-text-muted);
    font-size: 0.96rem;
    line-height: 1.8;
  }
  .join-card__desc a {
    color: var(--color-accent);
    font-weight: 640;
  }
  .contact-list {
    display: grid;
    gap: 0.85rem;
    font-style: normal;
  }
  .contact-item {
    display: grid;
    gap: 0.2rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
  }
  .contact-item__label {
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 640;
  }
  .contact-item__value {
    color: var(--color-text);
    font-size: 0.98rem;
    font-weight: 680;
    text-decoration: none;
    word-break: break-word;
  }
  a.contact-item__value:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 54rem) {
    .join-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
