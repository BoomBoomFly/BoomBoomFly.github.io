{
  "name": "boomboomfly-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "validate:content": "node tools/validate-generated.mjs",
    "test": "npm run validate:content && npm run check && npm run build",
    "test:browser": "playwright test tests/browser/smoke.spec.ts tests/browser/interactions.spec.ts tests/browser/formal-interactions.spec.ts",
    "test:a11y": "playwright test tests/browser/accessibility.spec.ts",
    "test:qa": "npm run test:browser && npm run test:a11y"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.3",
    "astro": "^7.0.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "typescript": "^6.0.3"
  }
}
